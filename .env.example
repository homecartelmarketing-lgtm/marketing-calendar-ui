# ==============================================================================
# Marketing Output UI - Production Environment Variables
# Copy these values into your Vercel Project Settings > Environment Variables
# ==============================================================================

# 1. Airtable Credentials
AIRTABLE_TOKEN=your_airtable_token_here
AIRTABLE_BASE_ID=appDM0jUDsaiThtR3

# 2. Meta Instagram Graph API Credentials
META_ACCESS_TOKEN=your_meta_page_access_token_here
META_PAGE_ID=1761624157420596
META_IG_ACCOUNT_ID=17841404109072695
META_API_VERSION=v19.0

# 3. Cloud Auto-Posting Security Secret (CRON_SECRET)
# Set a random secret string here (e.g., generate a strong random token)
# Vercel Cron will pass this secret in the Authorization header:
# Authorization: Bearer your_cron_secret
CRON_SECRET=your_random_cron_secret_here

# 3b. Durable Database (Neon Postgres via Vercel Marketplace)
# Connect Neon Postgres to your Vercel project to automatically inject DATABASE_URL
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# 3c. Automation Safety and Kill Switch
# Default outside production is disabled/simulated. Set to true to allow live publishing in non-production.
ENABLE_AUTOMATION_SCHEDULING=false
# Emergency kill switch: pause all runner executions immediately by setting to true
AUTOMATION_KILL_SWITCH=false
# Optional comma-separated Airtable record IDs allowlist for controlled production verification
AUTOMATION_ALLOWLIST_RECORDS=

# 4. Airtable Table IDs - Stories (CTA & Moodboard)
AIRTABLE_TABLE_ID_CHANDELIER_CTA=tblYHdVq14FjMWg5o
AIRTABLE_TABLE_ID_CLUSTER_CHANDELIER_CTA=tblSpGJLO3faYfIDY
